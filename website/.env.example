# ── Existing application (read-only integration) ─────────────────────────────
# Landing page of the existing Unique Care UK application (Login / Sign in /
# Create account). Used for the footer "Admin portal" link and per-job Apply links.
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://portal.example.com

# Read-only jobs source (existing application's Supabase project, anon key only).
NEXT_PUBLIC_JOBS_SUPABASE_URL=https://xjfihknleuwiocoaxsaw.supabase.co
NEXT_PUBLIC_JOBS_SUPABASE_ANON_KEY=your-anon-key

# ── Website backend (website_ tables only) ───────────────────────────────────
# Same Supabase project; anon key is enough (RLS: anon INSERT only,
# approved reviews SELECT only). No service role key anywhere.
NEXT_PUBLIC_SUPABASE_URL=https://xjfihknleuwiocoaxsaw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Unique Care UK Website <website@uniquecareuk.com>"
EMAIL_TO=info@uniquecareuk.com

# ── Spam protection (Cloudflare Turnstile) ───────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Secrets ──────────────────────────────────────────────────────────────────
REVALIDATE_SECRET=change-me
REVIEW_MODERATION_SECRET=change-me
