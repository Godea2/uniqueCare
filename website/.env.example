# ── Existing application (read-only integration) ─────────────────────────────
# Landing page of the existing Unique Care UK application (Login / Sign in /
# Create account). Used for the footer "Admin portal" link and per-job Apply links.
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://portal.example.com

# Read-only jobs source (existing application's Supabase project, anon key only).
NEXT_PUBLIC_JOBS_SUPABASE_URL=https://xjfihknleuwiocoaxsaw.supabase.co
NEXT_PUBLIC_JOBS_SUPABASE_ANON_KEY=your-anon-key

# ── Website backend (website_ tables only) ───────────────────────────────────
# Same Supabase project. Public forms use the anon key (RLS: anon INSERT only,
# approved reviews / published posts SELECT only).
NEXT_PUBLIC_SUPABASE_URL=https://xjfihknleuwiocoaxsaw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required by the /admin panel and review moderation. NEVER expose
# this to the browser (no NEXT_PUBLIC_ prefix) and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# ── Website admin panel (/admin) ─────────────────────────────────────────────
# The first admin is bootstrapped from these two values when the
# website_admin_users table is empty. Password must be at least 8 characters.
WEBSITE_ADMIN_EMAIL=admin@uniquecareuk.com
WEBSITE_ADMIN_PASSWORD=change-me-to-a-long-password
# Signs the admin session cookie. Use a long random string (e.g. `openssl rand -hex 32`).
WEBSITE_ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Google PageSpeed Insights key for /admin/seo/offpage (scores are
# shown as unavailable without it).
PAGESPEED_API_KEY=
# Optional: scan a different origin than content/site.ts `url` (e.g. staging).
SEO_SCAN_BASE_URL=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Unique Care UK Website <website@uniquecareuk.com>"
EMAIL_TO=info@uniquecareuk.com

# ── Spam protection (Cloudflare Turnstile) ───────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Secrets ──────────────────────────────────────────────────────────────────
REVALIDATE_SECRET=change-me
REVIEW_MODERATION_SECRET=change-me
