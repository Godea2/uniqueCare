# ── Existing application (read-only integration) ─────────────────────────────
# Portal URL: footer "Admin portal" link, Apply buttons, AND live job listings
# (fetched from /api/trpc/hr.publicJobs — same jobs as the portal careers page).
NEXT_PUBLIC_ADMIN_PORTAL_URL=https://unique-care-six.vercel.app

# Optional secondary jobs source (usually unused — RLS blocks anon on job_postings).
# NEXT_PUBLIC_JOBS_SUPABASE_URL=
# NEXT_PUBLIC_JOBS_SUPABASE_ANON_KEY=

# ── Website backend (website_ tables only) ───────────────────────────────────
# Same Supabase project; anon key is enough (RLS: anon INSERT only,
# approved reviews SELECT only). No service role key anywhere.
NEXT_PUBLIC_SUPABASE_URL=https://xjfihknleuwiocoaxsaw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Unique Care UK Website <website@uniquecareuk.com>"
EMAIL_TO=info@uniquecareuk.com

# ── Spam protection (Cloudflare Turnstile) ───────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Secrets ──────────────────────────────────────────────────────────────────
REVALIDATE_SECRET=change-me
REVIEW_MODERATION_SECRET=change-me
