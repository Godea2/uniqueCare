# ── Staff portal (careers + apply links) ─────────────────────────────────────
# Public careers listings are fetched from the portal: GET {url}/api/public/jobs
# (live job_postings only). Also used for footer "Admin portal" and Apply CTAs.
# Portal URL (production uses NEXT_PUBLIC_PORTAL_URL).
NEXT_PUBLIC_PORTAL_URL=https://portal.example.com
# Legacy aliases also accepted:
# NEXT_PUBLIC_ADMIN_PORTAL_URL=https://portal.example.com
# JOBS_PORTAL_URL=https://portal.example.com

# ── Website backend (website_ tables only) ───────────────────────────────────
# Same Supabase project. Public forms use the anon key (RLS: anon INSERT only,
# approved reviews / published posts SELECT only).
NEXT_PUBLIC_SUPABASE_URL=https://xjfihknleuwiocoaxsaw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by review moderation and the public subscribe/unsubscribe
# routes. NEVER expose this to the browser (no NEXT_PUBLIC_ prefix) and never
# commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# ── Website admin ────────────────────────────────────────────────────────────
# There is NO separate website login any more. Website admin (enquiries, reviews,
# applications, subscribers, newsletters, blog posts, audit log) lives in the staff
# portal under "Website" and is limited to the Registered Manager. /admin on this
# site just redirects to NEXT_PUBLIC_ADMIN_PORTAL_URL + "/website".
#
# Signs newsletter unsubscribe links. Must be the SAME value as
# WEBSITE_UNSUBSCRIBE_SECRET on the portal (the portal sends the newsletters).
WEBSITE_UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string

# ── Email (Resend, with portal SMTP fallback) ────────────────────────────────
# Prefer Resend for enquiry/review/subscribe mail. If Resend is unset or fails,
# the site POSTs to {JOBS_PORTAL_URL}/api/public/website-notify using the shared
# notify/revalidate secret so portal SMTP/Graph still delivers.
RESEND_API_KEY=
EMAIL_FROM="Unique Care UK Website <website@uniquecareuk.com>"
EMAIL_TO=info@uniquecareuk.com
# Optional dedicated notify secret (defaults to REVALIDATE_SECRET / WEBSITE_REVALIDATE_SECRET).
# WEBSITE_NOTIFY_SECRET=
# Must match portal WEBSITE_NOTIFY_SECRET || WEBSITE_REVALIDATE_SECRET || REVALIDATE_SECRET.


# ── Spam protection (Cloudflare Turnstile) ───────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Website AI chatbot ───────────────────────────────────────────────────────
# Preferred: leave GEMINI unset here and let the site call the portal bridge
# POST {JOBS_PORTAL_URL}/api/public/website-chat using the shared notify/revalidate
# secret. That reuses the portal GEMINI_API_KEY (same key as recruitment scoring)
# plus portal system prompt + knowledge chunks.
#
# Optional local fallback if the portal bridge is unavailable:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# Bridge auth (must match portal WEBSITE_NOTIFY_SECRET / WEBSITE_REVALIDATE_SECRET):
# WEBSITE_NOTIFY_SECRET=
# Knowledge docs are managed in the portal → Website → AI Assistant.

# ── Secrets ──────────────────────────────────────────────────────────────────
REVALIDATE_SECRET=change-me
REVIEW_MODERATION_SECRET=change-me
