# ── Database and auth (Supabase) ───────────────────────────────
SUPABASE_URL=             # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY= # service role key (server only; bypasses RLS)
# Optional anon key for client-side Supabase auth (never commit real keys)
# SUPABASE_ANON_KEY=

# ── Scheduled jobs ─────────────────────────────────────────────
# Bearer token for POST /api/cron/expiry-reminders (and /api/cron/daily)
# Send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=              # long random string; set the same value in Vercel / cron-job.org

# ── AI screening (Google Gemini) ───────────────────────────────
GEMINI_API_KEY=           # from https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.8-flash

# ── Outbound email (Hostinger SMTP) ────────────────────────────
# Without SMTP (or Graph below), emails are queued in email_outbox as "queued".
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=                # full mailbox address, e.g. recruitment@yourdomain
SMTP_PASSWORD=            # that mailbox's password
SMTP_FROM=                # same address, or "Unique Care UK <recruitment@yourdomain>"

# ── Optional: Microsoft Graph mail (offer letters / certificates) ─
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_SENDER=        # mailbox to send from

# ── App URL (used in portal / email links) ─────────────────────
# APP_URL=https://your-domain.example
# VITE_APP_URL=https://your-domain.example

# ── Marketing website cache bump (optional) ────────────────────
# When jobs go live/close/update, portal pings the website revalidate API.
# WEBSITE_URL=https://unique-care-477e.vercel.app
# WEBSITE_REVALIDATE_SECRET=   # same value as website REVALIDATE_SECRET

# -- Website admin (Website section in the portal, Registered Manager only) --
# Uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above (website_* tables) and the SMTP_* mailer.
# WEBSITE_URL / WEBSITE_REVALIDATE_SECRET above also refresh blog/reviews on the public site.
# Must match the website's WEBSITE_UNSUBSCRIBE_SECRET so newsletter unsubscribe links verify.
# WEBSITE_UNSUBSCRIBE_SECRET=
# Optional: public site origin for 'view post' links in the portal UI.
# VITE_WEBSITE_URL=https://uniquecareuk.com
